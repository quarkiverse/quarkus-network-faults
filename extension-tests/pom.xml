<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.networkfaults</groupId>
        <artifactId>quarkus-network-faults-parent</artifactId>
        <version>999-SNAPSHOT</version>
    </parent>
    <artifactId>quarkus-network-faults-extension-tests</artifactId>
    <name>Quarkus Network Faults - Extension Tests</name>
    <description>Tests that boot a Quarkus application against the extension itself, kept apart so that they build after every module they resolve</description>

    <properties>
        <automatic.module.name>io.quarkiverse.networkfaults.tests</automatic.module.name>
    </properties>

    <!-- Starting an application resolves every conditional dependency the core declares, which is every extension
         module, so these tests can only run once all of them are built: this module is listed after extensions in the
         root pom, and Maven keeps that order. The extension modules are not dependencies of this module, because on the
         class path they would pull their Quarkus extensions into every test application. -->
    <dependencies>
        <dependency>
            <groupId>io.quarkiverse.networkfaults</groupId>
            <artifactId>quarkus-network-faults-deployment</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-deployment</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
            <artifactId>microprofile-fault-tolerance-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx-http-deployment</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-internal</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-devui-test-spi</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
