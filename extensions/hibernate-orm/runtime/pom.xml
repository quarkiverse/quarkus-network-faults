<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.resiliencytesting</groupId>
        <artifactId>quarkus-resiliency-testing-hibernate-orm-parent</artifactId>
        <version>999-SNAPSHOT</version>
    </parent>
    <artifactId>quarkus-resiliency-testing-hibernate-orm</artifactId>
    <name>Quarkus Resiliency Testing - Hibernate ORM - Runtime</name>
    <description>Network fault targets for Hibernate ORM and Hibernate Reactive persistence units, resolved to their datasource; included automatically next to quarkus-resiliency-testing when quarkus-hibernate-orm is present</description>

    <properties>
        <!-- the Quarkus extension whose presence brings this module into a build; Hibernate Reactive depends on it -->
        <resiliency-testing.requires>io.quarkus:quarkus-hibernate-orm</resiliency-testing.requires>
        <automatic.module.name>io.quarkiverse.resiliencytesting.hibernateorm</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.quarkiverse.resiliencytesting</groupId>
            <artifactId>quarkus-resiliency-testing-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.resiliencytesting</groupId>
            <artifactId>quarkus-resiliency-testing-datasource-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
            <!-- as Hibernate Reactive does: a reactive-only application must not gain Agroal through this module -->
            <exclusions>
                <exclusion>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-agroal</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-narayana-jta</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-extension-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
