<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.resiliencytesting</groupId>
        <artifactId>quarkus-resiliency-testing-core-parent</artifactId>
        <version>999-SNAPSHOT</version>
    </parent>
    <artifactId>quarkus-resiliency-testing</artifactId>
    <name>Quarkus Resiliency Testing - Runtime</name>
    <description>Inject network faults into the outbound connections of a Quarkus application during tests</description>

    <properties>
        <automatic.module.name>io.quarkiverse.resiliencytesting</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.quarkiverse.resiliencytesting</groupId>
            <artifactId>quarkus-resiliency-testing-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-extension-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <executions>
                    <execution>
                        <phase>compile</phase>
                        <goals>
                            <goal>extension-descriptor</goal>
                        </goals>
                        <configuration>
                            <deployment>${project.groupId}:${project.artifactId}-deployment:${project.version}</deployment>
                            <!-- pulled into the build automatically when the matching Quarkus extension is present -->
                            <conditionalDevDependencies>
                                <artifact>${project.groupId}:${project.artifactId}-dev:${project.version}</artifact>
                            </conditionalDevDependencies>
                            <conditionalDependencies>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-agroal:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-reactive-datasource:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-rest-client:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-kafka-client:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-messaging-kafka:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-langchain4j:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-langchain4j-mcp:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-fault-tolerance:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-redis:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-graphql-client:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-grpc:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-data-hibernate:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-hibernate-orm:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-mongodb:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-mailer:${project.version}</artifact>
                                <artifact>${project.groupId}:quarkus-resiliency-testing-vertx:${project.version}</artifact>
                            </conditionalDependencies>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>io.quarkus</groupId>
                                    <artifactId>quarkus-extension-processor</artifactId>
                                </path>
                            </annotationProcessorPaths>
                            <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
