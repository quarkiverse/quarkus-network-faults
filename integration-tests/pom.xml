<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.networkfaults</groupId>
        <artifactId>quarkus-network-faults-parent</artifactId>
        <version>999-SNAPSHOT</version>
    </parent>
    <artifactId>quarkus-network-faults-integration-tests-parent</artifactId>
    <name>Quarkus Network Faults - Integration Tests - Parent</name>
    <packaging>pom</packaging>

    <modules>
        <module>rest-client-and-datasource</module>
        <module>kafka</module>
        <module>langchain4j</module>
        <module>langchain4j-mcp</module>
        <module>langchain4j-stores</module>
        <module>redis</module>
        <module>graphql-client</module>
        <module>grpc</module>
        <module>data-hibernate</module>
        <module>hibernate-reactive</module>
        <module>mongodb</module>
        <module>mailer</module>
    </modules>

    <dependencies>
        <!-- the extension is a test-only dependency, as it would be in a real application -->
        <dependency>
            <groupId>io.quarkiverse.networkfaults</groupId>
            <artifactId>quarkus-network-faults-junit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- every module is a Quarkus application; gRPC adds the generate-code goal -->
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
